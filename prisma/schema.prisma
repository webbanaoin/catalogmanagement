generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserStatus { ACTIVE DISABLED }
enum PlatformRole { USER ADMIN }
enum ShopStatus { PENDING APPROVED ACTIVE SUSPENDED REJECTED }
enum ShopUserRole { OWNER MANAGER STAFF }
enum CatalogStatus { ACTIVE INACTIVE }
enum PriceType { FIXED STARTING_FROM ASK_PRICE }
enum AvailabilityStatus { IN_STOCK OUT_OF_STOCK ON_REQUEST }

model User {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  email String @unique @db.VarChar(191)
  mobile String? @db.VarChar(30)
  passwordHash String @map("password_hash") @db.VarChar(255)
  status UserStatus @default(ACTIVE)
  platformRole PlatformRole @default(USER) @map("platform_role")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shopUsers ShopUser[]
  passwordResetTokens PasswordResetToken[]
  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model Shop {
  id String @id @default(cuid())
  businessCategoryId String? @map("business_category_id")
  name String @db.VarChar(160)
  slug String @unique @db.VarChar(191)
  tagline String? @db.VarChar(255)
  description String? @db.Text
  logoStorageKey String? @map("logo_storage_key") @db.VarChar(512)
  coverStorageKey String? @map("cover_storage_key") @db.VarChar(512)
  phone String? @db.VarChar(30)
  whatsapp String? @db.VarChar(30)
  email String? @db.VarChar(191)
  address String? @db.VarChar(500)
  city String? @db.VarChar(120)
  state String? @db.VarChar(120)
  pincode String? @db.VarChar(20)
  googleMapsUrl String? @map("google_maps_url") @db.VarChar(1024)
  instagramUrl String? @map("instagram_url") @db.VarChar(1024)
  facebookUrl String? @map("facebook_url") @db.VarChar(1024)
  status ShopStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shopUsers ShopUser[]
  businessCategory BusinessCategory? @relation(fields: [businessCategoryId], references: [id], onDelete: SetNull)
  categories ShopCategory[]
  products Product[]
  hours ShopHour[]
  @@index([businessCategoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@map("shops")
}

model ShopUser {
  id String @id @default(cuid())
  userId String @map("user_id")
  shopId String @map("shop_id")
  role ShopUserRole @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([userId, shopId])
  @@index([shopId, role])
  @@index([userId, role])
  @@map("shop_users")
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model BusinessCategory {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(160)
  icon String? @db.VarChar(255)
  status CatalogStatus @default(ACTIVE)
  displayOrder Int @default(0) @map("display_order")
  shops Shop[]
  @@index([status, displayOrder])
  @@map("business_categories")
}

model ShopCategory {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  parentId String? @map("parent_id")
  name String @db.VarChar(120)
  slug String @db.VarChar(160)
  imageStorageKey String? @map("image_storage_key") @db.VarChar(512)
  displayOrder Int @default(0) @map("display_order")
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent ShopCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ShopCategory[] @relation("CategoryTree")
  products Product[]
  @@unique([shopId, slug])
  @@index([shopId, status, displayOrder])
  @@index([parentId])
  @@map("shop_categories")
}

model Product {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  categoryId String? @map("category_id")
  name String @db.VarChar(180)
  slug String @db.VarChar(191)
  sku String? @db.VarChar(100)
  description String? @db.Text
  price Decimal? @db.Decimal(12, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(12, 2)
  priceType PriceType @default(FIXED) @map("price_type")
  availabilityStatus AvailabilityStatus @default(IN_STOCK) @map("availability_status")
  isFeatured Boolean @default(false) @map("is_featured")
  isNewArrival Boolean @default(false) @map("is_new_arrival")
  isOffer Boolean @default(false) @map("is_offer")
  isVisible Boolean @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images ProductImage[]
  attributes ProductAttribute[]
  @@unique([shopId, slug])
  @@unique([shopId, sku])
  @@index([shopId, isVisible, deletedAt, createdAt])
  @@index([shopId, categoryId, deletedAt])
  @@index([shopId, availabilityStatus, deletedAt])
  @@map("products")
}

model ProductImage {
  id String @id @default(cuid())
  productId String @map("product_id")
  storageKey String @map("storage_key") @db.VarChar(512)
  thumbnailKey String? @map("thumbnail_key") @db.VarChar(512)
  displayOrder Int @default(0) @map("display_order")
  isPrimary Boolean @default(false) @map("is_primary")
  fileSize Int? @map("file_size")
  mimeType String? @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductAttribute {
  id String @id @default(cuid())
  productId String @map("product_id")
  attributeName String @map("attribute_name") @db.VarChar(120)
  attributeValue String @map("attribute_value") @db.VarChar(500)
  displayOrder Int @default(0) @map("display_order")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, displayOrder])
  @@map("product_attributes")
}

model ShopHour {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  dayOfWeek Int @map("day_of_week") @db.TinyInt
  isClosed Boolean @default(false) @map("is_closed")
  openTime String? @map("open_time") @db.VarChar(5)
  closeTime String? @map("close_time") @db.VarChar(5)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, dayOfWeek])
  @@index([shopId])
  @@map("shop_hours")
}

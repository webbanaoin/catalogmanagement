generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ShopStatus {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ShopUserRole {
  OWNER
  MANAGER
  STAFF
}

model User {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(120)
  email        String       @unique @db.VarChar(191)
  mobile       String?      @db.VarChar(30)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  status       UserStatus   @default(ACTIVE)
  platformRole PlatformRole @default(USER) @map("platform_role")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  shopUsers    ShopUser[]

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model Shop {
  id                 String       @id @default(cuid())
  businessCategoryId String?      @map("business_category_id") @db.VarChar(191)
  name               String       @db.VarChar(160)
  slug               String       @unique @db.VarChar(191)
  tagline            String?      @db.VarChar(255)
  description        String?      @db.Text
  logoStorageKey     String?      @map("logo_storage_key") @db.VarChar(512)
  coverStorageKey    String?      @map("cover_storage_key") @db.VarChar(512)
  phone              String?      @db.VarChar(30)
  whatsapp           String?      @db.VarChar(30)
  email              String?      @db.VarChar(191)
  address            String?      @db.VarChar(500)
  city               String?      @db.VarChar(120)
  state              String?      @db.VarChar(120)
  pincode            String?      @db.VarChar(20)
  googleMapsUrl      String?      @map("google_maps_url") @db.VarChar(1024)
  instagramUrl       String?      @map("instagram_url") @db.VarChar(1024)
  facebookUrl        String?      @map("facebook_url") @db.VarChar(1024)
  status             ShopStatus   @default(PENDING)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  shopUsers          ShopUser[]

  // The business-category relation is introduced with the Sprint 2
  // BusinessCategory model. Keeping the scalar now preserves the target schema
  // without prematurely owning Sprint 2's model.
  @@index([businessCategoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@map("shops")
}

model ShopUser {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  shopId    String       @map("shop_id")
  role      ShopUserRole @default(STAFF)
  createdAt DateTime     @default(now()) @map("created_at")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop      Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([shopId, role])
  @@index([userId, role])
  @@map("shop_users")
}

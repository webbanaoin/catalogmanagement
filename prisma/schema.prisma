generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  USER
  ADMIN
}

enum ShopStatus {
  PENDING
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ShopUserRole {
  OWNER
  MANAGER
  STAFF
}

enum CatalogStatus {
  ACTIVE
  INACTIVE
}

enum PriceType {
  FIXED
  STARTING_FROM
  ASK_PRICE
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK
  ON_REQUEST
}

enum ImportJobStatus {
  PREVIEW_READY
  VALIDATION_FAILED
  COMPLETED
  FAILED
}

enum AnalyticsDeviceType {
  MOBILE
  TABLET
  DESKTOP
  OTHER
  UNKNOWN
}

enum CustomerActionType {
  WHATSAPP
  CALL
  DIRECTIONS
  SHARE
  PWA_INSTALL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  WAIVED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentRecordStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  WAIVED
}

model User {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  email String @unique @db.VarChar(191)
  mobile String? @db.VarChar(30)
  passwordHash String @map("password_hash") @db.VarChar(255)
  status UserStatus @default(ACTIVE)
  platformRole PlatformRole @default(USER) @map("platform_role")
  sessionVersion Int @default(0) @map("session_version")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shopUsers ShopUser[]
  passwordResetTokens PasswordResetToken[]
  auditLogs AuditLog[]
  receivedPayments PaymentRecord[] @relation("PaymentReceivedBy")
  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model Shop {
  id String @id @default(cuid())
  businessCategoryId String? @map("business_category_id")
  requestedBusinessType String? @map("requested_business_type") @db.VarChar(160)
  name String @db.VarChar(160)
  slug String @unique @db.VarChar(191)
  tagline String? @db.VarChar(255)
  description String? @db.Text
  logoStorageKey String? @map("logo_storage_key") @db.VarChar(512)
  coverStorageKey String? @map("cover_storage_key") @db.VarChar(512)
  phone String? @db.VarChar(30)
  whatsapp String? @db.VarChar(30)
  email String? @db.VarChar(191)
  address String? @db.VarChar(500)
  city String? @db.VarChar(120)
  state String? @db.VarChar(120)
  pincode String? @db.VarChar(20)
  googleMapsUrl String? @map("google_maps_url") @db.VarChar(1024)
  instagramUrl String? @map("instagram_url") @db.VarChar(1024)
  facebookUrl String? @map("facebook_url") @db.VarChar(1024)
  showProductPrices Boolean @default(true) @map("show_product_prices")
  status ShopStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shopUsers ShopUser[]
  businessCategory BusinessCategory? @relation(fields: [businessCategoryId], references: [id], onDelete: SetNull)
  categories ShopCategory[]
  products Product[]
  hours ShopHour[]
  importJobs ImportJob[]
  catalogVisits CatalogVisit[]
  productViews ProductView[]
  customerActions CustomerAction[]
  subscription Subscription?
  payments PaymentRecord[]
  auditLogs AuditLog[]
  @@index([businessCategoryId])
  @@index([status])
  @@index([city])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("shops")
}

model ShopUser {
  id String @id @default(cuid())
  userId String @map("user_id")
  shopId String @map("shop_id")
  role ShopUserRole @default(STAFF)
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([userId, shopId])
  @@index([shopId, role])
  @@index([userId, role])
  @@map("shop_users")
}

model PasswordResetToken {
  id String @id @default(cuid())
  userId String @map("user_id")
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  usedAt DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model BusinessCategory {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(160)
  icon String? @db.VarChar(255)
  status CatalogStatus @default(ACTIVE)
  displayOrder Int @default(0) @map("display_order")
  shops Shop[]
  @@index([status, displayOrder])
  @@map("business_categories")
}

model ShopCategory {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  parentId String? @map("parent_id")
  name String @db.VarChar(120)
  slug String @db.VarChar(160)
  imageStorageKey String? @map("image_storage_key") @db.VarChar(512)
  displayOrder Int @default(0) @map("display_order")
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  parent ShopCategory? @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ShopCategory[] @relation("CategoryTree")
  products Product[]
  @@unique([shopId, slug])
  @@index([shopId, status, displayOrder])
  @@index([parentId])
  @@map("shop_categories")
}

model Product {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  categoryId String? @map("category_id")
  catalogGroup String? @map("catalog_group") @db.VarChar(120)
  name String @db.VarChar(180)
  slug String @db.VarChar(191)
  sku String? @db.VarChar(100)
  description String? @db.Text
  price Decimal? @db.Decimal(12, 2)
  discountPrice Decimal? @map("discount_price") @db.Decimal(12, 2)
  priceType PriceType @default(FIXED) @map("price_type")
  availabilityStatus AvailabilityStatus @default(IN_STOCK) @map("availability_status")
  isFeatured Boolean @default(false) @map("is_featured")
  isNewArrival Boolean @default(false) @map("is_new_arrival")
  isOffer Boolean @default(false) @map("is_offer")
  isVisible Boolean @default(true) @map("is_visible")
  showPrice Boolean? @map("show_price")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category ShopCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images ProductImage[]
  attributes ProductAttribute[]
  views ProductView[]
  customerActions CustomerAction[]
  @@unique([shopId, slug])
  @@unique([shopId, sku])
  @@index([shopId, isVisible, deletedAt, createdAt])
  @@index([shopId, categoryId, deletedAt])
  @@index([shopId, catalogGroup, deletedAt])
  @@index([shopId, availabilityStatus, deletedAt])
  @@map("products")
}

model ProductImage {
  id String @id @default(cuid())
  productId String @map("product_id")
  storageKey String @map("storage_key") @db.VarChar(512)
  thumbnailKey String? @map("thumbnail_key") @db.VarChar(512)
  displayOrder Int @default(0) @map("display_order")
  isPrimary Boolean @default(false) @map("is_primary")
  fileSize Int? @map("file_size")
  mimeType String? @map("mime_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, displayOrder])
  @@index([productId, isPrimary])
  @@map("product_images")
}

model ProductAttribute {
  id String @id @default(cuid())
  productId String @map("product_id")
  attributeName String @map("attribute_name") @db.VarChar(120)
  attributeValue String @map("attribute_value") @db.VarChar(500)
  displayOrder Int @default(0) @map("display_order")
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, displayOrder])
  @@index([attributeName, attributeValue])
  @@map("product_attributes")
}

model ShopHour {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  dayOfWeek Int @map("day_of_week") @db.TinyInt
  isClosed Boolean @default(false) @map("is_closed")
  openTime String? @map("open_time") @db.VarChar(5)
  closeTime String? @map("close_time") @db.VarChar(5)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@unique([shopId, dayOfWeek])
  @@index([shopId])
  @@map("shop_hours")
}

model Plan {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  slug String @unique @db.VarChar(160)
  description String? @db.VarChar(500)
  monthlyPrice Decimal @default(0) @map("monthly_price") @db.Decimal(12, 2)
  annualPrice Decimal @default(0) @map("annual_price") @db.Decimal(12, 2)
  productLimit Int @map("product_limit")
  imageLimitPerProduct Int @map("image_limit_per_product")
  analyticsEnabled Boolean @default(false) @map("analytics_enabled")
  excelImportEnabled Boolean @default(false) @map("excel_import_enabled")
  customBrandingEnabled Boolean @default(false) @map("custom_branding_enabled")
  trialDays Int @default(0) @map("trial_days")
  graceDays Int @default(0) @map("grace_days")
  isDefaultTrial Boolean @default(false) @map("is_default_trial")
  status CatalogStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  subscriptions Subscription[]
  payments PaymentRecord[]
  @@index([status])
  @@index([isDefaultTrial, status])
  @@map("plans")
}

model PaymentRecord {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  subscriptionId String? @map("subscription_id")
  planId String? @map("plan_id")
  receivedByUserId String? @map("received_by_user_id")
  amount Decimal @db.Decimal(12, 2)
  status PaymentRecordStatus
  method PaymentMethod
  paymentDate DateTime @map("payment_date")
  referenceId String? @map("reference_id") @db.VarChar(191)
  gatewayOrderId String? @map("gateway_order_id") @db.VarChar(191)
  gatewayPaymentId String? @map("gateway_payment_id") @db.VarChar(191)
  notes String? @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  receivedBy User? @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([shopId, paymentDate])
  @@index([subscriptionId, paymentDate])
  @@index([status, paymentDate])
  @@index([method, paymentDate])
  @@map("payment_records")
}

model Subscription {
  id String @id @default(cuid())
  shopId String @unique @map("shop_id")
  planId String @map("plan_id")
  startDate DateTime @map("start_date")
  endDate DateTime @map("end_date")
  graceEndsAt DateTime? @map("grace_ends_at")
  status SubscriptionStatus
  paymentStatus PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments PaymentRecord[]
  @@index([planId, status])
  @@index([status, endDate])
  @@map("subscriptions")
}

model ImportJob {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  fileName String @map("file_name") @db.VarChar(255)
  totalRows Int @default(0) @map("total_rows")
  successfulRows Int @default(0) @map("successful_rows")
  failedRows Int @default(0) @map("failed_rows")
  status ImportJobStatus
  previewData Json? @map("preview_data")
  errorSummary Json? @map("error_summary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, status, createdAt])
  @@map("import_jobs")
}

model CatalogVisit {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  sessionId String @map("session_id") @db.VarChar(128)
  source String? @db.VarChar(80)
  deviceType AnalyticsDeviceType @default(UNKNOWN) @map("device_type")
  visitedAt DateTime @default(now()) @map("visited_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId, visitedAt])
  @@index([shopId, sessionId, visitedAt])
  @@index([shopId, source, visitedAt])
  @@map("catalog_visits")
}

model ProductView {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  productId String @map("product_id")
  sessionId String @map("session_id") @db.VarChar(128)
  source String? @db.VarChar(80)
  viewedAt DateTime @default(now()) @map("viewed_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([shopId, viewedAt])
  @@index([shopId, productId, viewedAt])
  @@index([shopId, sessionId, viewedAt])
  @@map("product_views")
}

model CustomerAction {
  id String @id @default(cuid())
  shopId String @map("shop_id")
  productId String? @map("product_id")
  sessionId String @map("session_id") @db.VarChar(128)
  actionType CustomerActionType @map("action_type")
  source String? @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at")
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([shopId, createdAt])
  @@index([shopId, actionType, createdAt])
  @@index([shopId, productId, createdAt])
  @@index([shopId, sessionId, createdAt])
  @@map("customer_actions")
}


model AuditLog {
  id String @id @default(cuid())
  actorUserId String? @map("actor_user_id")
  shopId String? @map("shop_id")
  action String @db.VarChar(120)
  entityType String @map("entity_type") @db.VarChar(80)
  entityId String? @map("entity_id") @db.VarChar(191)
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([shopId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

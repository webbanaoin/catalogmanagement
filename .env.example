# Application
NODE_ENV=development
APP_URL=http://localhost:3000
# Production must use the final HTTPS origin, for example https://catalog.example.com.
# Generate a unique high-entropy value; never reuse it between environments.
AUTH_SECRET=replace-with-at-least-32-characters

# MySQL / Prisma
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
SHADOW_DATABASE_URL=mysql://catalog_app:replace-me@localhost:3306/catalog_management_shadow

# S3-compatible object storage (AWS S3, Cloudflare R2, etc.)
# Cloudflare R2: AWS_REGION=auto and AWS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_REGION=
AWS_S3_ENDPOINT=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN/media origin. Business records must still persist only storage keys.
MEDIA_BASE_URL=
